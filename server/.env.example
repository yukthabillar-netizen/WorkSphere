NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/worksphere
JWT_ACCESS_SECRET=worksphere_jwt_access_secret_super_secret_key_12345
JWT_REFRESH_SECRET=worksphere_jwt_refresh_secret_super_secret_key_67890
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLIENT_URL=http://localhost:5173

# Optional: Real Email Delivery via SMTP (e.g. Gmail App Password, Resend, Brevo, SendGrid, etc.)
# If left blank, verification codes are logged cleanly to the server terminal console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="WorkSphere" <noreply@worksphere.io>
